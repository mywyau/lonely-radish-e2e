E2E_BASE_URL=http://localhost:3000
E2E_START_LOCAL_APP=false

# Authenticated Playwright storage states created from dedicated test accounts.
E2E_MEMBER_A_STATE=.auth/member-a.json
E2E_MEMBER_B_STATE=.auth/member-b.json
E2E_NEW_MEMBER_STATE=.auth/new-member.json

# Stable Auth0 subject IDs and public profile details for the two lifecycle accounts.
E2E_MEMBER_A_ID=
E2E_MEMBER_A_NAME=
E2E_MEMBER_A_SLUG=
E2E_MEMBER_B_ID=
E2E_MEMBER_B_NAME=
E2E_MEMBER_B_SLUG=

# Use a direct connection to an isolated E2E/staging database, never production.
E2E_DATABASE_URL=
E2E_ALLOW_DATABASE_RESET=false
E2E_DATABASE_SSL=true
