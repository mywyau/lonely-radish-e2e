E2E_BASE_URL=http://localhost:3000
E2E_START_LOCAL_APP=false

# Staging safety lock. All three values must match the intended Preview deployment.
E2E_TARGET_ENV=staging
E2E_ALLOWED_HOST=
E2E_PRODUCTION_URL=https://lonelyradish.app

# Optional: Vercel Deployment Protection "Protection Bypass for Automation".
E2E_VERCEL_BYPASS_SECRET=
E2E_VERCEL_BYPASS_STATE=.auth/vercel-bypass.json

# Authenticated Playwright storage states created from dedicated test accounts.
E2E_MEMBER_A_STATE=.auth/member-a.json
E2E_MEMBER_B_STATE=.auth/member-b.json
E2E_NEW_MEMBER_STATE=.auth/new-member.json
E2E_SEED_MANIFEST=.auth/staging-users.json

# Staging-only Auth0 tenant/application. Grant the M2M application read:users, create:users, and update:users.
E2E_AUTH0_DOMAIN=
E2E_AUTH0_MGMT_CLIENT_ID=
E2E_AUTH0_MGMT_CLIENT_SECRET=
E2E_AUTH0_CONNECTION=Username-Password-Authentication
E2E_TEST_PASSWORD=
E2E_MEMBER_A_EMAIL=
E2E_MEMBER_B_EMAIL=
E2E_NEW_MEMBER_EMAIL=

# Stable Auth0 subject IDs and public profile details for the two lifecycle accounts.
E2E_MEMBER_A_ID=
E2E_MEMBER_A_NAME=
E2E_MEMBER_A_SLUG=
E2E_MEMBER_B_ID=
E2E_MEMBER_B_NAME=
E2E_MEMBER_B_SLUG=

# Use a direct connection to an isolated E2E/staging database, never production.
E2E_DATABASE_URL=
E2E_ALLOW_DATABASE_RESET=false
E2E_DATABASE_SSL=true
E2E_EXPECTED_DATABASE_HOST=
E2E_EXPECTED_DATABASE_PROJECT_REF=

# Optional: creates a real Stripe test-mode Checkout session without completing payment.
E2E_RUN_STRIPE_CHECKOUT=false
E2E_VERCEL_BYPASS_SECRET=

E2E_MEMBER_A_EMAIL=
E2E_MEMBER_B_EMAIL=
E2E_NEW_MEMBER_EMAIL=

STAGING_EMAIL_ALLOWLIST=m.yw.yau+lr-e2e-a@gmail.com,m.yw.yau+lr-e2e-b@gmail.com,m.yw.yau+lr-e2e-new@gmail.com